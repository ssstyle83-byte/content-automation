# ── Anthropic API ────────────────────────────────────
ANTHROPIC_API_KEY=여기에_API_키_입력

# ── 네이버 검색 API (선택) ──────────────────────────
# 리뷰 감정 분석 등 부가 기능에 사용 (없어도 수집 가능)
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret

# ────────────────────────────────────────────────────
# 스마트스토어 판매자 어드민 로그인
# sell.smartstore.naver.com 판매자 계정 (네이버 아이디)
SMARTSTORE_ID=네이버_판매자_아이디
SMARTSTORE_PW=네이버_판매자_비밀번호
# ────────────────────────────────────────────────────
# 기타 채널(쿠팡/카페24/ESM플러스/11번가/SSG)은
# 공개 쇼핑몰 페이지에서 리뷰를 수집하므로 아이디/비밀번호 없이 동작합니다.
# ────────────────────────────────────────────────────
